# Single-container Dokploy deploy: nginx + community API + creation service,
# supervised by s6-overlay. Dokploy builds THIS file (Dockerfile.dokploy);
# the multi-stage `Dockerfile` stays for local Compose.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY apps/website/package*.json ./apps/website/
COPY packages/core/package*.json ./packages/core/
COPY packages/tokens/package*.json ./packages/tokens/
COPY packages/ui/package*.json ./packages/ui/
COPY packages/catalog/package*.json ./packages/catalog/
COPY packages/composition/package*.json ./packages/composition/
RUN npm ci
COPY . .
RUN npm run build

# Runtime: nginx + two node services under s6-overlay
FROM node:22-alpine AS dokploy
ARG S6_OVERLAY_VERSION=3.2.0.2
RUN apk add --no-cache xz nginx ffmpeg chromium ca-certificates curl \
    && curl -fsSL -o /tmp/s6.tar.xz https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz \
    && curl -fsSL -o /tmp/s6arch.tar.xz https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz \
    && tar -C / -Jxpf /tmp/s6.tar.xz && tar -C / -Jxpf /tmp/s6arch.tar.xz \
    && rm /tmp/s6*.tar.xz
ENV HOST=0.0.0.0 \
    COMMUNITY_DB=/data/community.sqlite \
    STUDIO_DB=/data/studio.sqlite \
    BRAG_PORT=9184 \
    COOKIE_SECURE=1 \
    TRUST_PROXY=1 \
    HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium
WORKDIR /app
COPY --from=build /app/services/community/ ./services/community/
COPY --from=build /app/services/brag/ ./services/brag/
COPY --from=build /app/node_modules/ ./node_modules/
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/packages/ ./packages/
COPY --from=build /app/apps/web/public/demo/ ./apps/web/public/demo/
COPY --from=build /app/apps/website/dist/ ./srv/website/
COPY --from=build /app/apps/web/dist/ ./srv/web/
COPY docker/s6/ /etc/s6-overlay/s6-rc.d/
COPY dokploy-nginx.conf /etc/nginx/http.d/default.conf
RUN mkdir -p /etc/s6-overlay/user-bundles.d/user/contents.d \
        /etc/s6-overlay/s6-rc.d/nginx/dependencies.d/base \
        /etc/s6-overlay/s6-rc.d/community/dependencies.d/base \
        /etc/s6-overlay/s6-rc.d/brag/dependencies.d/base \
        /data /run/nginx \
    && touch /etc/s6-overlay/user-bundles.d/user/contents.d/nginx \
             /etc/s6-overlay/user-bundles.d/user/contents.d/community \
             /etc/s6-overlay/user-bundles.d/user/contents.d/brag \
    && echo longrun > /etc/s6-overlay/s6-rc.d/nginx/type \
    && echo longrun > /etc/s6-overlay/s6-rc.d/community/type \
    && echo longrun > /etc/s6-overlay/s6-rc.d/brag/type \
    && chown -R node:node /data \
    && chmod +x /etc/s6-overlay/s6-rc.d/nginx/run \
                 /etc/s6-overlay/s6-rc.d/community/run \
                 /etc/s6-overlay/s6-rc.d/brag/run
VOLUME /data
EXPOSE 80
ENTRYPOINT ["/init"]
